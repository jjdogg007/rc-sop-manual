rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SOP sections — anyone can read; only authenticated users can write
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Policy change log — anyone can read; only authenticated users can write
    match /policyLog/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Shift checklists — only the owning user can read/write their document
    match /checklists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
